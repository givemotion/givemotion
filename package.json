{
  "name": "givemotion",
  "version": "0.1.0",
  "description": "Make videos with AI, free and open source (MIT). A code-to-video engine built for AI agents like Claude Code, Cursor and Codex: the agent writes HTML/CSS, checks and previews its own video, and renders MP4.",
  "type": "module",
  "license": "MIT",
  "author": "Leonardo Grigorio (https://github.com/leonardogrig)",
  "homepage": "https://givemotion.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardogrig/givemotion.git"
  },
  "bugs": "https://github.com/leonardogrig/givemotion/issues",
  "bin": {
    "givemotion": "src/cli.js"
  },
  "main": "src/api.js",
  "exports": {
    ".": "./src/api.js",
    "./react": "./src/react/index.jsx",
    "./runtime": "./src/runtime/runtime.js",
    "./preset.css": "./src/runtime/preset.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "blocks",
    "templates",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "llms.txt",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/unit.test.js test/e2e.test.js test/features.test.js",
    "bench": "node src/cli.js bench"
  },
  "keywords": [
    "video",
    "html-to-video",
    "animation",
    "motion-graphics",
    "ai",
    "agents",
    "claude",
    "render",
    "mp4",
    "ffmpeg",
    "headless-chrome",
    "ai-video",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills",
    "motion-design",
    "video-generation",
    "programmatic-video",
    "explainer-video",
    "social-video",
    "captions",
    "data-visualization",
    "open-source",
    "free",
    "mit"
  ],
  "peerDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
