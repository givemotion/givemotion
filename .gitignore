out/
snapshots/
.gm-parts/
*.mp4
*.mov
*.webm
*.mkv
*.gif
*.mp3
*.wav
!examples/**/assets/*.mp4
!docs/media/*.gif

# Secrets and local config: never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.npmrc

# Packaging
*.tgz

# Logs and temp files
*.log
npm-debug.log*
.npm/
.cache/
tmp/
coverage/
__pycache__/
*.pyc

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local agent state (the plugin manifests in .claude-plugin/ stay tracked)
.claude/
CLAUDE.local.md

